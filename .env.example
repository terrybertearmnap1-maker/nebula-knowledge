# Copy this file to .env and fill in your key.
# Any OpenAI-compatible endpoint works. These defaults target DeepSeek.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# Force the deterministic offline model (true/false).
# When omitted, demo mode is enabled automatically if LLM_API_KEY is empty.
# DEMO_MODE=false

# Web search: auto | tavily | bing | ddgs | disabled
# auto uses Tavily when TAVILY_API_KEY is set, otherwise keyless Bing RSS.
# Bing/DuckDuckGo are best-effort local fallbacks; use Tavily in production.
WEB_SEARCH_PROVIDER=auto
# TAVILY_API_KEY=tvly-你的Key
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT_SECONDS=20

# Team knowledge base settings.
# DATA_DIR=./data
# MAX_UPLOAD_MB=10
# CHUNK_SIZE=900
# CHUNK_OVERLAP=120
# RETRIEVAL_TOP_K=5

# Optional runtime settings.
# CORS_ORIGINS=*
# MAX_INPUT_CHARS=4000
